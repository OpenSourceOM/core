# OpenSourceOM environment configuration
# Copy to .env and fill in values before running docker compose up

# --- General ---
OM_ENV=development
OM_LOG_LEVEL=info
# Browser origin for OAuth callbacks and setup links. No trailing path.
OM_PUBLIC_URL=http://localhost:8080

# --- API ---
OM_API_PORT=8080
# Machine credential for /v1 routes other than health, the session probe, and logout.
# Empty leaves those routes open. The console does not use this value.
OM_API_SECRET=change-me-in-production

# Console login. Set a client id and secret for Google, GitHub, or both.
# Register the callback {OM_PUBLIC_URL}/auth/google/callback or
# {OM_PUBLIC_URL}/auth/github/callback. With no admin yet, the API log prints
# a one-time setup link.
# OM_GOOGLE_CLIENT_ID=
# OM_GOOGLE_CLIENT_SECRET=
# OM_GITHUB_CLIENT_ID=
# OM_GITHUB_CLIENT_SECRET=

# --- Graph store (placeholder) ---
OM_GRAPH_BACKEND=postgres
POSTGRES_USER=opensourceom
POSTGRES_PASSWORD=opensourceom
POSTGRES_DB=opensourceom
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Collectors ---
# AWS (read-only role recommended)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Azure (DefaultAzureCredential: az login, managed identity, or env vars)
# AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# GCP (Application Default Credentials)
# GCP_PROJECT_ID=
GCP_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Enrichment ---
# Optional NVD API key for higher rate limits.
# NVD matches CPE 2.3 names on workload packages.
# NVD_API_KEY=
# JSON catalog used instead of NVD. Matches package URLs and image refs too.
# OM_CVE_CATALOG=examples/cve-catalog.json

# --- Kubernetes ---
K8S_CLUSTER=default
# K8S_NAMESPACE=

# --- Exports ---
# SLACK_WEBHOOK_URL=
# JIRA_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT=SEC

# --- Optional integrations ---
# SLACK_WEBHOOK_URL=
# JIRA_URL=
